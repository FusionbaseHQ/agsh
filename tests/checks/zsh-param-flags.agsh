# RUN: %agsh %s
v=hello
echo ${(U)v}
w=WORLD
echo ${(L)w}
t="hello world"
echo ${(C)t}
p="a:b:c"
echo ${(s.:.)p}
a=(z y x)
echo ${(o)a[@]}
echo ${(O)a[@]}
n=(3 1 2 10)
echo ${(on)n[@]}
d=(a b a c b)
echo ${(u)d[@]}
echo ${(j.-.)a[@]}
ref=v
echo ${(P)ref}
m=$(printf 'l1\nl2\nl3')
echo ${(f)m}
echo ${(ou)d[@]}
# CHECK: HELLO
# CHECK: world
# CHECK: Hello World
# CHECK: a b c
# CHECK: x y z
# CHECK: z y x
# CHECK: 1 2 3 10
# CHECK: a b c
# CHECK: z-y-x
# CHECK: hello
# CHECK: l1 l2 l3
# CHECK: a b c
