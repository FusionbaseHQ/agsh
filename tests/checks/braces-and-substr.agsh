# RUN: %agsh %s
echo {1..5}
echo {5..1}
echo {0..10..2}
echo {01..10}
echo {a..e}
echo {a..e..2}
echo {-2..2}
echo pre{1..3}post
echo {1..3}{a,b}
v=hello
echo ${v:1:2}
echo ${v:2}
echo ${v: -2}
ref=v; echo ${!ref}
# CHECK: 1 2 3 4 5
# CHECK: 5 4 3 2 1
# CHECK: 0 2 4 6 8 10
# CHECK: 01 02 03 04 05 06 07 08 09 10
# CHECK: a b c d e
# CHECK: a c e
# CHECK: -2 -1 0 1 2
# CHECK: pre1post pre2post pre3post
# CHECK: 1a 1b 2a 2b 3a 3b
# CHECK: el
# CHECK: llo
# CHECK: lo
# CHECK: hello
